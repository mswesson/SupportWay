# Пример переменных окружения для локального запуска без Docker.
# Скопируй в .env и при необходимости поправь значения.

SUPPORT_SERVICE_VERSION=1.0.0

SUPPORT_DATABASE_USER=support
SUPPORT_DATABASE_PASSWORD=support
SUPPORT_DATABASE_HOST=localhost
SUPPORT_DATABASE_PORT=5432
SUPPORT_DATABASE_NAME=support

SUPPORT_REDIS_URL=redis://localhost:6379/0

SUPPORT_JWT_SECRET=dev-secret-change-me
# SUPPORT_INTEGRATION_API_KEY=dev-integration-key
